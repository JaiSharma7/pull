# env
#
# Ignore by default, then allow back the three that are committed on purpose.
# Law 7 in CLAUDE.md: .env.development points at the local stack and
# .env.production at the hosted project, both carrying only the publishable key,
# so a fresh clone runs with no setup. Everything else — and every *.local
# override — stays out.
#
# The negations are load-bearing. A bare `.env*` also matches those three, and
# they survive today only because they are already tracked; deleting and
# re-adding one would silently drop it from the repo.
.env*
!.env.example
!.env.development
!.env.production
.env*.local

# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.pem

# logs
*-debug.log*
*-error.log*
logs/

# deploy
.vercel

# claude local overrides
.claude/settings.local.json
.gstack/

# The two directories the BAML CLI writes backups into. Both names are in the
# 0.17.0 binary; `*.baml-backup/` was already here, and `baml agent install`
# uses the other -- it copies whatever it replaces to
# `.claude/skills/baml-old_skills/` and `.agents/skills/baml-old_skills/`, so
# every refresh of the generated `baml-core` skill left two untracked trees
# beside it, each holding a stale duplicate of the reference it just replaced.
*.baml-backup/
baml-old_skills/

# Recordings and reports from `pnpm record`. Video of a local stack, regenerated
# on demand and never worth a diff.
artifacts/
