# Committed on purpose. See law 7 in CLAUDE.md.
#
# A VITE_* variable is compiled into the bundle every visitor downloads, so this file
# is public by construction. The publishable key is the one credential designed for
# that: it identifies the project, and RLS — enabled on all 40 tables and asserted by
# CI check 4 — is what actually protects the data behind it.
#
# Nothing else belongs here. The secret key, provider keys and the dispatch token are
# server-side only.
VITE_SUPABASE_URL=https://zjvfwhjwaytyogdxeddo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_FFodjTdZJuSdDZkCQlqO6Q_ikfASHHu
