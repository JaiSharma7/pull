# You do not normally need this file. Both environments ship with values:
#
#   .env.development   local stack (127.0.0.1:54321) — used by `pnpm dev`
#   .env.production    the hosted project            — used by `pnpm build`
#
# So a fresh clone is `pnpm db:start && pnpm dev`, with nothing to configure.
#
# Copy this to .env.local (gitignored) only to point the app somewhere else — your own
# Supabase project, or a local stack printing different keys than the committed ones.
#
# Only the publishable key belongs in a VITE_* variable: it is compiled into the bundle
# every visitor downloads, and RLS is what protects the data behind it. The secret key
# (`sb_secret_…`) and every provider key are server-side only, and a local-stack key must
# never be used against production. See law 7 in CLAUDE.md.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Refuse to start a dev server against anything but the local stack.
#
# `.env.production` carries the hosted URL, and this repository is public — so the
# easiest mistake to make is developing against live reader data. RLS keeps you inside
# your own account, which is exactly why it cannot help here: every write a dev server
# makes is one that account is allowed to make.
#
# Set this to `true` in .env.local only if you mean to point a dev server at a hosted
# project. A production build is unaffected either way.
# VITE_ALLOW_REMOTE_SUPABASE=true
