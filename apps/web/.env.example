# Supabase project the app talks to.
# Local stack:  http://127.0.0.1:54321 with the key printed by `pnpm db:start`.
#
# Only the publishable key belongs in a VITE_* variable — it is compiled into the
# bundle every visitor downloads. The secret key (`sb_secret_…` / service_role) and
# every provider key are server-side only. See law 7 in CLAUDE.md.
#
# Production values are committed in .env.production, which is why deploying needs no
# dashboard step.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
