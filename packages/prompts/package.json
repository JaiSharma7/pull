{
  "name": "@wap/prompts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "baml:check": "baml check",
    "baml:generate": "baml generate && node -e \"import('node:fs').then(fs => fs.promises.unlink('baml_sdk/.gitignore').catch(() => {}))\"",
    "baml:test": "baml test",
    "baml:export": "node scripts/export.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@wap/config": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@boundaryml/baml-bridge": "0.17.0"
  }
}
